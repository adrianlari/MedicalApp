<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MedicalApp.ViewModels"
             xmlns:models="clr-namespace:MedicalApp.Models"
             x:Class="MedicalApp.Views.PatientsPage"
             x:DataType="viewmodels:PatientsViewModel"
             Title="Patients">

    <Grid RowDefinitions="Auto,*" Padding="10">
        
        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="0" 
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="{StaticResource Primary}"
                          Margin="0,10"/>

        <!-- Patients List -->
        <CollectionView Grid.Row="1"
                       ItemsSource="{Binding Patients}"
                       SelectionMode="Single"
                       SelectedItem="{Binding SelectedPatient}"
                       SelectionChangedCommand="{Binding ViewPatientDetailsCommand}"
                       SelectionChangedCommandParameter="{Binding SelectedPatient}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Patient">
                    <Frame Margin="5" 
                           Padding="15"
                           BackgroundColor="White"
                           CornerRadius="10"
                           HasShadow="True">
                        <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="15">
                            
                            <!-- Avatar Placeholder -->
                            <Frame Grid.Column="0"
                                   WidthRequest="60"
                                   HeightRequest="60"
                                   CornerRadius="30"
                                   BackgroundColor="{StaticResource Primary}"
                                   Padding="0">
                                <Label Text="{Binding FirstName, StringFormat='{0:C1}'}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>

                            <!-- Patient Info -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding FullName}"
                                       FontSize="18"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding Age, StringFormat='{0} years old'}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray600}"/>
                                <Label Text="{Binding PhoneNumber}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray600}"/>
                            </VerticalStackLayout>

                            <!-- Blood Type Badge -->
                            <Frame Grid.Column="2"
                                   BackgroundColor="{StaticResource Secondary}"
                                   Padding="10,5"
                                   CornerRadius="15"
                                   VerticalOptions="Center">
                                <Label Text="{Binding BloodType}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="14"/>
                            </Frame>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
