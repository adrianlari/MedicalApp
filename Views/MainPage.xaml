<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MedicalApp.ViewModels"
             x:Class="MedicalApp.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="MedConnect Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Header -->
            <Label Text="MedConnect"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center"
                   Margin="0,20,0,10"/>
            
            <Label Text="Medical Management System"
                   FontSize="16"
                   TextColor="{StaticResource Gray600}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,30"/>

            <!-- Dashboard Cards -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="15" RowSpacing="15">
                
                <!-- Total Patients Card -->
                <Frame Grid.Column="0" Grid.Row="0" 
                       BackgroundColor="{StaticResource Primary}"
                       CornerRadius="10"
                       Padding="20">
                    <VerticalStackLayout>
                        <Label Text="&#xf0c0;" 
                               FontFamily="FontAwesome" 
                               FontSize="32" 
                               TextColor="White"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding TotalPatients}"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0"/>
                        <Label Text="Total Patients"
                               FontSize="14"
                               TextColor="White"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Today's Appointments Card -->
                <Frame Grid.Column="1" Grid.Row="0"
                       BackgroundColor="{StaticResource Secondary}"
                       CornerRadius="10"
                       Padding="20">
                    <VerticalStackLayout>
                        <Label Text="&#xf073;" 
                               FontFamily="FontAwesome" 
                               FontSize="32" 
                               TextColor="White"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding TodayAppointments}"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0"/>
                        <Label Text="Today"
                               FontSize="14"
                               TextColor="White"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Upcoming Appointments Card -->
                <Frame Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                       BackgroundColor="{StaticResource Tertiary}"
                       CornerRadius="10"
                       Padding="20">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                        <Label Text="&#xf274;" 
                               FontFamily="FontAwesome" 
                               FontSize="32" 
                               TextColor="White"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout>
                            <Label Text="{Binding UpcomingAppointments}"
                                   FontSize="36"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="Upcoming Appointments"
                                   FontSize="14"
                                   TextColor="White"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Frame>
            </Grid>

            <!-- Quick Actions -->
            <Label Text="Quick Actions"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,20,0,10"/>

            <Button Text="View All Patients"
                    Command="{Binding NavigateToPatientsCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"/>

            <Button Text="View Appointments"
                    Command="{Binding NavigateToAppointmentsCommand}"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"/>

            <Button Text="Book New Appointment"
                    Command="{Binding BookAppointmentCommand}"
                    BackgroundColor="{StaticResource Tertiary}"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
