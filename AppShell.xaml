<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MedicalApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MedicalApp.Views"
    Shell.FlyoutBehavior="Flyout">

    <TabBar>
        <ShellContent
            Title="Dashboard"
            Icon="home.png"
            ContentTemplate="{DataTemplate views:MainPage}"
            Route="main" />

        <ShellContent
            Title="Patients"
            Icon="patients.png"
            ContentTemplate="{DataTemplate views:PatientsPage}"
            Route="patients" />

        <ShellContent
            Title="Appointments"
            Icon="calendar.png"
            ContentTemplate="{DataTemplate views:AppointmentsPage}"
            Route="appointments" />
    </TabBar>

</Shell>
